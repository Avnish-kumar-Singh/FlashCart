# FlashCart local demo
# Get TEST keys from the Razorpay Dashboard. Never commit real/live secrets.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

RAZORPAY_KEY_ID=key_id_here
RAZORPAY_KEY_SECRET=key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Twilio (real SMS delivery for OTPs and order updates). Get these from
# console.twilio.com — Account SID + Auth Token from the dashboard home,
# and a phone number with SMS capability from Phone Numbers > Manage.
# If any of these three are left blank, the app falls back to logging
# the SMS text to the console instead of sending it.
#
# Trial accounts can ONLY send to phone numbers you've verified in the
# Twilio console (Phone Numbers > Verified Caller IDs) — this is the
# #1 reason a trial-account SMS silently never arrives.
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15017122661
# Preferred for Twilio trial accounts and approved OTP templates.
# If set, this is used instead of TWILIO_FROM_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=MGyour_messaging_service_sid
# Country code prepended to phone numbers that are typed without one
# (e.g. a 10-digit Indian mobile number). Change if most of your users
# are outside India.
TWILIO_DEFAULT_COUNTRY_CODE=+91

# Invoice email delivery via SMTP with STARTTLS (usually port 587).
# Leave blank to generate invoices but keep email delivery pending locally.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=Your_Account_ID/Email_Address
# SMTP_PASSWORD= 16_character_app_password
# SMTP_FROM=your_email_address
# RAZORPAY_KEY_ID=key_id_here
# RAZORPAY_KEY_SECRET=key_secret_here
